{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebulalm.local/schemas/experiment.schema.json",
  "title": "NebulaLM experiment registration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "experiment_id",
    "registered_at",
    "hypothesis",
    "decision_informed",
    "primary_metric",
    "secondary_metrics",
    "changed_variables",
    "controlled_variables",
    "dataset_manifest_sha256",
    "split_manifest_sha256",
    "tokenizer_sha256",
    "evaluation_bundle_sha256",
    "code_commit",
    "environment_id",
    "seeds",
    "valid_token_budget",
    "wall_clock_cap",
    "evaluation_intervals",
    "stop_rule",
    "tie_rule",
    "planned_runs",
    "known_deviations",
    "status"
  ],
  "properties": {
    "experiment_id": {"type": "string", "pattern": "^EXP-[A-Z0-9-]+$"},
    "registered_at": {"type": "string"},
    "hypothesis": {"type": "string"},
    "decision_informed": {"type": "string"},
    "primary_metric": {"type": "string"},
    "secondary_metrics": {"type": "array", "items": {"type": "string"}},
    "changed_variables": {"type": "object"},
    "controlled_variables": {"type": "object"},
    "dataset_manifest_sha256": {"type": "string"},
    "split_manifest_sha256": {"type": "string"},
    "tokenizer_sha256": {"type": "string"},
    "evaluation_bundle_sha256": {"type": "string"},
    "code_commit": {"type": "string"},
    "environment_id": {"type": "string"},
    "seeds": {"type": "array", "items": {"type": "object"}},
    "valid_token_budget": {"type": ["string", "integer", "null"]},
    "wall_clock_cap": {"type": ["string", "null"]},
    "evaluation_intervals": {"type": ["string", "null"]},
    "stop_rule": {"type": "string"},
    "tie_rule": {"type": "string"},
    "planned_runs": {"type": "array"},
    "known_deviations": {"type": "array", "items": {"type": "string"}},
    "status": {"type": "string", "enum": ["registered", "completed", "superseded"]}
  }
}
