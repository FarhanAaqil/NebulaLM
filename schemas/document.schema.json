{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebulalm.local/schemas/document.schema.json",
  "title": "NebulaLM document manifest record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "source",
    "source_record_id",
    "title",
    "canonical_url",
    "revision_id",
    "published_at",
    "retrieved_at",
    "author_attribution",
    "license_id",
    "license_url",
    "rights_notes",
    "raw_sha256",
    "clean_sha256",
    "pipeline_version",
    "language_score",
    "quality_flags",
    "dedup_cluster_id",
    "split"
  ],
  "properties": {
    "document_id": {"type": "string", "pattern": "^doc_[a-z0-9_]+_[A-Za-z0-9._-]+$"},
    "source": {"type": "string", "minLength": 1},
    "source_record_id": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "canonical_url": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "published_at": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string", "minLength": 1},
    "author_attribution": {"type": "array", "items": {"type": "string"}},
    "license_id": {"type": "string", "minLength": 1},
    "license_url": {"type": "string"},
    "rights_notes": {"type": "string"},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "clean_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pipeline_version": {"type": "string", "minLength": 1},
    "language_score": {"type": "number", "minimum": 0, "maximum": 1},
    "quality_flags": {"type": "array", "items": {"type": "string"}},
    "dedup_cluster_id": {"type": "string"},
    "split": {"type": "string", "enum": ["train", "validation", "test", "probe", "cloze_reserve", "excluded"]},
    "rejection_reasons": {"type": "array", "items": {"type": "string"}},
    "is_representative": {"type": "boolean"},
    "quality_score": {"type": "number"}
  }
}
